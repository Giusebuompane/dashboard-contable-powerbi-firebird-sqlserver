		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test IVA_470_Inicial' =
			
			VAR _fechaMaxima =
			    MAXX(
			        ALLSELECTED(Calendario[Fecha]),
			        Calendario[Fecha]
			    )
			
			VAR _anioSeleccionado =
			    YEAR(_fechaMaxima)
			
			VAR _inicioEjercicioAnterior =
			    DATE(_anioSeleccionado - 1, 1, 1)
			
			VAR _finEjercicioAnterior =
			    DATE(_anioSeleccionado - 1, 12, 31)
			
			VAR IVA_470_Inicial =
			    CALCULATE(
			        SUMX(
			            DIA_2026,
			            DIA_2026[HABER] - DIA_2026[DEBE]
			        ),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Fecha],
			            _inicioEjercicioAnterior,
			            _finEjercicioAnterior
			        ),
			        FILTER(
			            ALL(
			                DIA_2026[CUENTA],
			                DIA_2026[TIPO]
			            ),
			            LEFT(TRIM(DIA_2026[CUENTA]), 3) = "470"
			                &&
			            UPPER(
			                TRIM(
			                    SUBSTITUTE(
			                        COALESCE(DIA_2026[TIPO], ""),
			                        UNICHAR(160),
			                        ""
			                    )
			                )
			            ) = "CIER"
			        )
			    )
			
			RETURN
			    IF(
			        ISBLANK(_fechaMaxima),
			        BLANK(),
			        IVA_470_Inicial
			    )
		lineageTag: c2e3c3c2-f6d7-4e78-8351-1cb8f3a2de0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test IVA_470_Movimientos' =
			
			VAR _fechaMaxima =
			    MAXX(
			        ALLSELECTED(Calendario[Fecha]),
			        Calendario[Fecha]
			    )
			
			VAR _anioSeleccionado =
			    YEAR(_fechaMaxima)
			
			VAR _inicioEjercicio =
			    DATE(_anioSeleccionado, 1, 1)
			
			VAR IVA_470_Movimientos =
			    CALCULATE(
			        SUMX(
			            DIA_2026,
			            DIA_2026[DEBE] - DIA_2026[HABER]
			        ),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Fecha],
			            _inicioEjercicio,
			            _fechaMaxima
			        ),
			        FILTER(
			            ALL(
			                DIA_2026[CUENTA],
			                DIA_2026[TIPO]
			            ),
			            LEFT(TRIM(DIA_2026[CUENTA]), 3) = "470"
			                &&
			            UPPER(
			                TRIM(
			                    SUBSTITUTE(
			                        COALESCE(DIA_2026[TIPO], ""),
			                        UNICHAR(160),
			                        ""
			                    )
			                )
			            ) <> "PERD"
			        )
			    )
			
			RETURN
			    IF(
			        ISBLANK(_fechaMaxima),
			        BLANK(),
			        IVA_470_Movimientos
			    )
		lineageTag: 98882492-854e-4774-b02a-0310414d16d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test Fecha Maxima' = MAXX(ALLSELECTED(Calendario[Fecha]), Calendario[Fecha])
