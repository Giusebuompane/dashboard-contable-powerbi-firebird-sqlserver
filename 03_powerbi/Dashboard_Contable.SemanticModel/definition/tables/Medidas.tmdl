table Medidas
	lineageTag: 7fa7cf0e-d8c0-4588-ba64-d00c1d8c6361

	measure 'Total Facturado' =
			
			VAR Resultado =
			    SUMX(
			        FILTER(
			            DIA_2026,
			            LEFT(FORMAT(DIA_2026[CUENTA], "0"), 1) = "7"
			                &&
			            NOT (
			                UPPER(
			                    TRIM(
			                        SUBSTITUTE(
			                            COALESCE(DIA_2026[TIPO], ""),
			                            UNICHAR(160),
			                            ""
			                        )
			                    )
			                ) IN {"PERD", "CIER"}
			            )
			        ),
			        DIA_2026[HABER] - DIA_2026[DEBE]
			    )
			-- Primer día del periodo según el calendario, sin el recorte que hace DIA (relación bidireccional) a los días con apuntes
			VAR _inicioPeriodo =
			    CALCULATE(MIN(Calendario[Fecha]), CROSSFILTER(DIA_2026[FECHA], Calendario[Fecha], OneWay))
			RETURN
			    IF(
			        _inicioPeriodo > TODAY(),
			        BLANK(),
			        IF(ABS(Resultado) < 0.01, 0, Resultado)
			    )
		lineageTag: d1ba515b-34f7-473d-addb-915d221b3a22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Gastos' =
			
			VAR Resultado =
			    SUMX(
			        FILTER(
			            DIA_2026,
			            LEFT(FORMAT(DIA_2026[CUENTA], "0"), 1) = "6"
			                &&
			            NOT (
			                UPPER(
			                    TRIM(
			                        SUBSTITUTE(
			                            COALESCE(DIA_2026[TIPO], ""),
			                            UNICHAR(160),
			                            ""
			                        )
			                    )
			                ) IN {"PERD", "CIER"}
			            )
			        ),
			        DIA_2026[DEBE] - DIA_2026[HABER]
			    )
			RETURN
			    IF(
			        ABS(Resultado) < 0.01,
			        0,
			        Resultado
			    )
		lineageTag: 0e140601-dc61-4b6a-8fcd-e314b41bb048

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Margen =
			
			[Total Facturado] - [Total Gastos]
		lineageTag: b4edd1ec-bafd-4ac6-b2d8-1234b0016917

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Margen' =
			
			DIVIDE(
			    [Margen],
			    [Total Facturado],
			    0
			)
		lineageTag: cf7e0b78-9804-4459-b86a-3f8656f7e6e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Saldo =
			
			SUM(DIA_2026[DEBE]) - SUM(DIA_2026[HABER])
		lineageTag: f6a631a0-e55c-443f-a03e-8d13c1f1077d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total IVA a liquidar' =
			
			VAR _hoy = TODAY()
			VAR _maxCal = MAX(Calendario[Fecha])
			VAR _fechaMaxima = IF(ISBLANK(_maxCal), BLANK(), IF(_maxCal > _hoy, _hoy, _maxCal))
			VAR _anioSeleccionado = YEAR(_fechaMaxima)
			VAR _inicioEjercicio = DATE(_anioSeleccionado, 1, 1)
			VAR _esCierreIVA =
			    FILTER(
			        ALL(DIA_2026[CUENTA], DIA_2026[CONCEPTO]),
			        LEFT(UPPER(TRIM(COALESCE(DIA_2026[CONCEPTO], ""))), 10) = "CIERRE IVA"
			    )
			VAR _iva475Periodo =
			    CALCULATE(
			        SUMX(DIA_2026, DIA_2026[HABER] - DIA_2026[DEBE]),
			        FILTER(_esCierreIVA, LEFT(TRIM(DIA_2026[CUENTA]), 3) = "475")
			    )
			VAR _ultima475 =
			    CALCULATE(
			        MAX(DIA_2026[FECHA]),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(Calendario[Fecha], _inicioEjercicio, _fechaMaxima),
			        FILTER(_esCierreIVA, LEFT(TRIM(DIA_2026[CUENTA]), 3) = "475")
			    )
			VAR _inicioArrastre = IF(ISBLANK(_ultima475), _inicioEjercicio, _ultima475 + 1)
			VAR _iva470Arrastre =
			    IF(
			        _inicioArrastre > _fechaMaxima,
			        0,
			        CALCULATE(
			            SUMX(DIA_2026, DIA_2026[HABER] - DIA_2026[DEBE]),
			            REMOVEFILTERS(Calendario),
			            DATESBETWEEN(Calendario[Fecha], _inicioArrastre, _fechaMaxima),
			            FILTER(_esCierreIVA, LEFT(TRIM(DIA_2026[CUENTA]), 3) = "470")
			        )
			    )
			VAR _inicioTrimestreActual = DATE(_anioSeleccionado, (QUARTER(_fechaMaxima) - 1) * 3 + 1, 1)
			VAR _cierreTrimestreActual =
			    CALCULATE(
			        COUNTROWS(DIA_2026),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(Calendario[Fecha], _inicioTrimestreActual, EOMONTH(_inicioTrimestreActual, 2)),
			        FILTER(_esCierreIVA, LEFT(TRIM(DIA_2026[CUENTA]), 3) IN {"475", "470"})
			    )
			VAR _trimestreAbierto = _cierreTrimestreActual = 0
			VAR _ivaTrimestreEnCurso =
			    CALCULATE(
			        SUMX(DIA_2026, DIA_2026[HABER] - DIA_2026[DEBE]),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(Calendario[Fecha], _inicioTrimestreActual, _fechaMaxima),
			        FILTER(ALL(DIA_2026[CUENTA]), LEFT(TRIM(DIA_2026[CUENTA]), 3) IN {"477", "472"})
			    )
			-- Saldo de IVA a compensar en 4700/4709. Solo cuentan las subcuentas que han recibido algún CIERRE IVA de esa empresa;
			-- las que no (p.ej. devoluciones de Impuesto de Sociedades) se excluyen. DIA no trae asiento de apertura:
			-- el saldo inicial se toma del CIERRE DE EJERCICIO del año anterior con signo contrario.
			VAR _saldoIVA470 =
			    SUMX(
			        VALUES(DIA_2026[Codigo_empresa]),
			        VAR _subcuentasIVA =
			            CALCULATETABLE(
			                VALUES(DIA_2026[CUENTA]),
			                REMOVEFILTERS(Calendario),
			                FILTER(ALL(DIA_2026[CONCEPTO]), LEFT(UPPER(TRIM(COALESCE(DIA_2026[CONCEPTO], ""))), 10) = "CIERRE IVA"),
			                FILTER(ALL(DIA_2026[CUENTA]), LEFT(TRIM(DIA_2026[CUENTA]), 4) IN {"4700", "4709"})
			            )
			        VAR _inicial =
			            - CALCULATE(
			                SUMX(DIA_2026, DIA_2026[HABER] - DIA_2026[DEBE]),
			                REMOVEFILTERS(Calendario),
			                FILTER(ALL(DIA_2026[FECHA]), DIA_2026[FECHA] = DATE(_anioSeleccionado - 1, 12, 31)),
			                _subcuentasIVA,
			                FILTER(ALL(DIA_2026[TIPO]), UPPER(TRIM(SUBSTITUTE(COALESCE(DIA_2026[TIPO], ""), UNICHAR(160), ""))) = "CIER")
			            )
			        VAR _movimientos =
			            CALCULATE(
			                SUMX(DIA_2026, DIA_2026[HABER] - DIA_2026[DEBE]),
			                REMOVEFILTERS(Calendario),
			                FILTER(ALL(DIA_2026[FECHA]), DIA_2026[FECHA] >= _inicioEjercicio && DIA_2026[FECHA] <= _fechaMaxima),
			                _subcuentasIVA,
			                FILTER(ALL(DIA_2026[TIPO]), UPPER(TRIM(SUBSTITUTE(COALESCE(DIA_2026[TIPO], ""), UNICHAR(160), ""))) <> "CIER")
			            )
			        RETURN _inicial + _movimientos
			    )
			VAR Resultado =
			    IF(
			        _trimestreAbierto,
			        _ivaTrimestreEnCurso + _saldoIVA470,
			        _iva475Periodo + _iva470Arrastre
			    )
			RETURN
			    IF(
			        ISBLANK(_fechaMaxima) || MIN(Calendario[Fecha]) > _hoy,
			        BLANK(),
			        IF(ABS(Resultado) < 0.01, 0, Resultado)
			    )
		lineageTag: 02da515e-1066-4918-8862-ec06718a1649

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Saldo Bancos' =
			
			VAR _fechaMaxima =
			    MAX(Calendario[Fecha])
			
			VAR _anioSeleccionado =
			    YEAR(_fechaMaxima)
			
			VAR _inicioEjercicio =
			    DATE(_anioSeleccionado, 1, 1)
			
			/* =====================================================
			   Si el ano seleccionado ya tiene su asiento de cierre contable
			   (TIPO=CIER a 31/12), ese es el saldo real conciliado con el
			   extracto bancario -- lo usamos directamente en vez de sumar
			   los movimientos, porque puede haber ajustes de conciliacion
			   que no estan reflejados como movimientos individuales.
			   Si el ano sigue abierto (aun no se ha cerrado, ej. el ano en
			   curso), usamos el ultimo cierre conocido + los movimientos
			   del ano en curso.
			   ===================================================== */
			
			VAR _cierreEsteAnio =
			    CALCULATE(
			        SUMX(
			            DIA_2026,
			            DIA_2026[HABER] - DIA_2026[DEBE]
			        ),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Fecha],
			            _inicioEjercicio,
			            _fechaMaxima
			        ),
			        FILTER(
			            ALL(
			                DIA_2026[CUENTA],
			                DIA_2026[TIPO]
			            ),
			            LEFT(FORMAT(DIA_2026[CUENTA], "0"), 3) = "572"
			                && DIA_2026[TIPO] = "CIER"
			        )
			    )
			
			VAR _numCierreEsteAnio =
			    CALCULATE(
			        COUNTROWS(DIA_2026),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Fecha],
			            _inicioEjercicio,
			            _fechaMaxima
			        ),
			        FILTER(
			            ALL(
			                DIA_2026[CUENTA],
			                DIA_2026[TIPO]
			            ),
			            LEFT(FORMAT(DIA_2026[CUENTA], "0"), 3) = "572"
			                && DIA_2026[TIPO] = "CIER"
			        )
			    )
			
			VAR _saldoInicial =
			    CALCULATE(
			        SUMX(
			            DIA_2026,
			            DIA_2026[HABER] - DIA_2026[DEBE]
			        ),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Fecha],
			            DATE(_anioSeleccionado - 1, 1, 1),
			            DATE(_anioSeleccionado - 1, 12, 31)
			        ),
			        FILTER(
			            ALL(
			                DIA_2026[CUENTA],
			                DIA_2026[TIPO]
			            ),
			            LEFT(FORMAT(DIA_2026[CUENTA], "0"), 3) = "572"
			                && DIA_2026[TIPO] = "CIER"
			        )
			    )
			
			VAR _movimientosEsteAnio =
			    CALCULATE(
			        SUMX(
			            DIA_2026,
			            DIA_2026[DEBE] - DIA_2026[HABER]
			        ),
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Fecha],
			            _inicioEjercicio,
			            _fechaMaxima
			        ),
			        FILTER(
			            ALL(
			                DIA_2026[CUENTA],
			                DIA_2026[TIPO]
			            ),
			            LEFT(FORMAT(DIA_2026[CUENTA], "0"), 3) = "572"
			                && NOT(DIA_2026[TIPO] IN {"PERD", "CIER"})
			        )
			    )
			
			VAR Resultado =
			    IF(
			        _numCierreEsteAnio > 0,
			        _cierreEsteAnio,
			        _saldoInicial + _movimientosEsteAnio
			    )
			
			RETURN
			    IF(
			        ISBLANK(_fechaMaxima),
			        BLANK(),
			        IF(
			            ABS(Resultado) < 0.01,
			            0,
			            Resultado
			        )
			    )
		lineageTag: 1efeca46-7a59-4542-89f8-082aeaf19283

