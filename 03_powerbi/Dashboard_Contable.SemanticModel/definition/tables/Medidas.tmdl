	/// Texto con flecha (▲/▼) y el % Margen, para usar como tooltip/campo junto a la tarjeta de Margen.
	measure 'Margen Indicador' =
			VAR pct = [% Margen]
			RETURN IF(pct >= 0, "▲ " & FORMAT(pct, "0.0%"), "▼ " & FORMAT(ABS(pct), "0.0%"))
		displayFolder: KPI
		lineageTag: eb88dd2c-3056-4ab5-9808-f536f6303163

	/// Color hexadecimal para formato condicional del texto de Margen Indicador (verde si es positivo, rojo si es negativo).
	measure 'Margen Indicador Color' = IF([% Margen] >= 0, "#149226", "#C0392B")
		displayFolder: KPI
		lineageTag: 53d28abe-3ce0-4fdd-aea1-7e68dedfbff6

