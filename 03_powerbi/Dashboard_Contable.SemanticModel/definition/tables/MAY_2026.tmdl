	column Llave_compuesta = ```
			
			FORMAT(MAY_2026[Año], "0") 
			& "-" & 
			FORMAT(MAY_2026[CODIGO], "0") 
			& "-" & 
			FORMAT(MAY_2026[Codigo_empresa], "0")
			```
		lineageTag: 285a4a35-7491-46ec-8481-fb5b98a57120
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Es Cuenta 640' =
			
			IF(
			    LEFT(FORMAT(MAY_2026[CODIGO], "0"), 3) = "640",
			    "Sí",
			    "No"
			)
		lineageTag: bc0f1a0b-57d7-47c7-aecd-5c7273e27ae8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

