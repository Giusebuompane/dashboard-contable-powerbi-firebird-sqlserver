	hierarchy 'Fecha Jerarquía'
		lineageTag: 8d148caf-fe30-4f5f-bb93-b066fc2a2529

		level Fecha
			lineageTag: a0726dc2-7139-4eb2-b877-b5747d54b1d7
			column: Fecha

	partition Calendario = m
		mode: import
		source =
				let
				    // Obtener fechas de la tabla DIA
				    FechasDIA = List.RemoveNulls(DIA_2026[FECHA]),
				
				    TodasFechas = FechasDIA,
				
				    // Fecha mínima y máxima
				    FechaMin = List.Min(TodasFechas),
				    FechaMax = List.Max(TodasFechas),
				
				    // Generar lista de fechas
				    ListaFechas = List.Dates(
				        FechaMin,
				        Duration.Days(FechaMax - FechaMin) + 1,
				        #duration(1, 0, 0, 0)
				    ),
				
				    // Convertir a tabla
				    TablaCalendario = Table.FromList(
				        ListaFechas,
				        Splitter.SplitByNothing(),
				        {"Fecha"}
				    ),
				
				    // Columnas auxiliares
				    AñadirAño = Table.AddColumn(TablaCalendario, "Año", each Date.Year([Fecha]), Int64.Type),
				    AñadirMes = Table.AddColumn(AñadirAño, "Mes", each Date.Month([Fecha]), Int64.Type),
				    AñadirDía = Table.AddColumn(AñadirMes, "Día", each Date.Day([Fecha]), Int64.Type),
				    AñadirNombreMes = Table.AddColumn(AñadirDía, "NombreMes", each Date.ToText([Fecha], "MMMM"), type text),
				    AñadirTrimestre = Table.AddColumn(AñadirNombreMes, "Trimestre", each "T" & Number.ToText(Date.QuarterOfYear([Fecha])), type text),
				    AñadirDiaSemana = Table.AddColumn(AñadirTrimestre, "DiaSemana", each Date.DayOfWeek([Fecha], Day.Monday) + 1, Int64.Type),
				    AñadirNombreDiaSemana = Table.AddColumn(AñadirDiaSemana, "NombreDiaSemana", each Date.ToText([Fecha], "dddd"), type text),
				    AñadirMesAño = Table.AddColumn(AñadirNombreDiaSemana, "MesAño", each Date.ToText([Fecha], "MMM yyyy"), type text),
				    AñadirAñoMes = Table.AddColumn(
				        AñadirMesAño,
				        "AñoMes",
				        each Number.ToText(Date.Year([Fecha])) & Text.PadStart(Number.ToText(Date.Month([Fecha])), 2, "0"),
				        type text
				    ),
				
				    #"Tipo cambiado" = Table.TransformColumnTypes(AñadirAñoMes, {{"Fecha", type date}})
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

