	partition MAY_INTERMEDIA = calculated
		mode: import
		source = ```
				
				DISTINCT(
				    SELECTCOLUMNS(
				        MAY_2026,
				        "Año", MAY_2026[Año],
				        "CODIGO", MAY_2026[CODIGO],
				        "Codigo_empresa", MAY_2026[Codigo_empresa],
				        "Llave_compuesta", 
				            FORMAT(MAY_2026[Año], "0") 
				            & "-" & 
				            FORMAT(MAY_2026[CODIGO], "0") 
				            & "-" & 
				            FORMAT(MAY_2026[Codigo_empresa], "0")
				    )
				)
