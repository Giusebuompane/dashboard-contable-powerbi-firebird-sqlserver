	column Llave_compuesta_MAY =
			
			DIA_2026[Año] & "-" & FORMAT(LEFT(DIA_2026[CUENTA],12), "0") & "-" & FORMAT(DIA_2026[Codigo_empresa], "0")
		lineageTag: dbc05c64-384d-4ee0-88e1-8f81efd1a2d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Llave_compuesta_CLA =
			
			DIA_2026[Año] & "-" & DIA_2026[CLAVE] & "-" & DIA_2026[Codigo_empresa]
		lineageTag: a83626d2-3e44-40f0-8a3a-057af8c35c7e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Llave_compuesta_DOC =
			
			DIA_2026[Año] & "-" & FORMAT(DIA_2026[CODREGIS], "0") & "-" & FORMAT(DIA_2026[Codigo_empresa], "0")
		lineageTag: 56b7192d-f6a5-4bb6-ba24-50e457514562
